# ── App ──────────────────────────────────────────────────────
APP_NAME=PaperMind
DEBUG=false

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://papermind:papermind@localhost:5432/papermind
DATABASE_URL_SYNC=postgresql://papermind:papermind@localhost:5432/papermind

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Groq API (required for Q&A and review features) ─────────
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ── Agent (LangGraph research agent) ────────────────────────
# qwen/qwen3.8-27b has reliable tool-calling on Groq free tier
AGENT_MODEL_NAME=qwen/qwen3.8-27b
AGENT_MAX_ITERATIONS=5

# ── Semantic Scholar (optional — works without key) ──────────
SEMANTIC_SCHOLAR_API_KEY=

# ── Embedding Model ─────────────────────────────────────────
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── CORS (comma-separated origins) ──────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
